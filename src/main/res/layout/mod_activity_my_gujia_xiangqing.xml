<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="vm"
            type="com.box.mod.ui.activity.ModActivityMyGujiaXiangqing.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.activity.ModActivityMyGujiaXiangqing.ProxyClick" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/idp_10"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/idp_15"
                android:paddingVertical="@dimen/idp_15">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/textRootView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/idp_90"
                        android:layout_marginTop="@dimen/idp_10"
                        android:layout_marginBottom="@dimen/idp_4"
                        android:background="@drawable/gujia_xiangqing_title_bg"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/idp_50"
                        android:paddingBottom="@dimen/idp_10"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_5"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{StringUtils.format(&quot;游戏名：%s&quot;,vm.modData.gameName)}"
                            android:textColor="#253E75"
                            android:textSize="@dimen/isp_14"
                            android:textStyle="bold"
                            tools:text="游戏名：王者荣耀" />

                        <Button
                            android:id="@+id/commit"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/idp_26"
                            android:layout_marginTop="@dimen/idp_10"
                            android:layout_marginBottom="@dimen/idp_3"
                            android:background="@drawable/gujia_item_btn_bg"
                            android:text="我要估值"
                            android:textColor="@color/white"
                            android:textSize="@dimen/isp_12"
                            android:textStyle="bold"
                            android:visibility="gone" />


                    </LinearLayout>

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="@dimen/idp_58"
                        android:layout_height="@dimen/idp_58"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/idp_3"
                        android:elevation="@dimen/idp_4"
                        app:cornerRadius="@{10f}"
                        app:hideOnNullOrError="@{false}"
                        app:imageUrl="@{vm.modData.gameIcon}"
                        app:layout_constraintEnd_toEndOf="@id/textRootView"
                        app:layout_constraintStart_toStartOf="@id/textRootView"
                        tools:src="@drawable/mod_icon" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/idp_25"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="账号估值"
                    android:textColor="@color/text_default_color"
                    android:textSize="@dimen/isp_13"
                    tools:text="账号估值" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/idp_5"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{vm.modData.getCheckMoney()}"
                    android:textColor="#F2510C"
                    android:textSize="@dimen/isp_16"
                    android:textStyle="bold"
                    tools:text="￥126768.00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_20"
                    android:background="@drawable/gujia_layout_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/idp_10"
                    android:paddingVertical="@dimen/idp_20">

                    <com.box.common.ui.view.DrawableTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/idp_5"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="账号详情"
                        android:textSize="@dimen/isp_16"
                        android:textStyle="bold"
                        app:drawableHeight="@dimen/idp_18"
                        app:drawableWidth="@dimen/idp_7" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_10"
                        android:orientation="horizontal"
                        tools:itemCount="2"
                        tools:listitem="@layout/mod_item_custom_form_xiangqing" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_10"
                        android:orientation="horizontal"
                        tools:itemCount="1"
                        tools:listitem="@layout/mod_item_custom_form_xiangqing_pic" />

                </LinearLayout>

                <com.box.common.ui.view.DrawableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_20"
                    android:drawableStart="@drawable/gujia_xiangqing_ic_jinggao"
                    android:drawablePadding="@dimen/idp_5"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="温馨提示"
                    android:textColor="#F2510C"
                    android:textSize="@dimen/isp_13"
                    android:textStyle="bold"
                    app:drawableHeight="@dimen/idp_20"
                    app:drawableWidth="@dimen/idp_20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/idp_5"
                    android:ellipsize="end"
                    android:text="        账号价格为基于账号内等级、道具、稀有物品等现有信息的估算值，实际价值可能受游戏官方规则调整、市场供需波动、账号绑定状态等因素影响，最终价格以游戏内核实结果或双方协商为准。"
                    android:textColor="@color/text_default_color"
                    android:textSize="@dimen/isp_13"
                    tools:text="        账号价格为基于账号内等级、道具、稀有物品等现有信息的估算值，实际价值可能受游戏官方规则调整、市场供需波动、账号绑定状态等因素影响，最终价格以游戏内核实结果或双方协商为准。" />

                <com.box.common.ui.view.DrawableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_20"
                    android:drawablePadding="@dimen/idp_5"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="其他热门游戏账号估值"
                    android:textSize="@dimen/isp_16"
                    android:textStyle="bold"
                    app:drawableHeight="@dimen/idp_18"
                    app:drawableWidth="@dimen/idp_7" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_10"
                    android:orientation="horizontal"
                    tools:itemCount="1"
                    tools:listitem="@layout/mod_item_gujia_game_re" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


    </RelativeLayout>
</layout>