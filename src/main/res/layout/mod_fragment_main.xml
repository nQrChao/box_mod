<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="vm"
            type="com.box.mod.ui.fragment.ModFragmentMain.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.fragment.ModFragmentMain.ProxyClick" />
    </data>

    <LinearLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mod_home_bg_color"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/idp_10">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/idp_70"
            android:paddingVertical="@dimen/idp_8">

            <ImageView
                android:id="@+id/user_icon"
                android:layout_width="@dimen/idp_50"
                android:layout_height="@dimen/idp_50"
                android:layout_centerVertical="true"
                android:onClick="@{()->click.user()}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:userAvatarInfo="@{vm.modUserInfo}"
                tools:src="@drawable/mod_user_icon1" />

            <LinearLayout
                android:id="@+id/f1_title_user_account_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/idp_10"
                android:layout_toEndOf="@id/user_icon"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/user_icon"
                app:layout_constraintStart_toEndOf="@id/user_icon"
                app:layout_constraintTop_toTopOf="@id/user_icon">

                <TextView
                    android:id="@+id/f1_title_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:onClick="@{()->click.user()}"
                    android:text="@{vm.modUserInfo.nickName ?? `点击登录`}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/isp_13"
                    android:textStyle="bold"
                    tools:text="兜兜里的糖糖" />

                <TextView
                    android:id="@+id/f1_title_user_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{vm.modUserInfo == null ? `` : StringUtils.format(&quot;ID: %s&quot;, vm.modUserInfo.userId)}"
                    android:textColor="#8A8A8A"
                    android:textSize="@dimen/isp_13"
                    tools:text="ID：23279" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mod_bg_f1_title_user_soucang"
                android:onClick="@{()->click.shoucang()}"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/idp_3"
                android:paddingStart="@dimen/idp_12"
                android:paddingEnd="@dimen/idp_15"
                app:layout_constraintBottom_toBottomOf="@id/user_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/user_icon">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieShoucang"
                    android:layout_width="@dimen/idp_30"
                    android:layout_height="@dimen/idp_30"
                    android:layout_gravity="center"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/star" />

                <com.box.common.ui.view.DrawableTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/idp_5"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="收藏"
                    android:textColor="@color/black"
                    android:textSize="@dimen/isp_13"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/user_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/user_icon"
                    tools:text="收藏" />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.box.common.ui.layout.StatusLayout
            android:id="@+id/status_loading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.box.other.scwang.smartrefresh.layout.SmartRefreshLayout
                android:id="@+id/refreshLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                app:srlEnableLoadMore="true"
                app:srlEnableRefresh="true">

                <com.box.other.scwang.smart.refresh.header.MaterialHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nestedScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/contentView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/idp_40"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/hornView"
                                    android:layout_width="@dimen/idp_22"
                                    android:layout_height="@dimen/idp_22"
                                    android:layout_gravity="center_vertical"
                                    android:src="@drawable/horn_ic" />

                                <com.box.common.ui.widget.marqueeview.MarqueeView
                                    android:id="@+id/marqueeview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginHorizontal="@dimen/idp_10"
                                    android:background="@drawable/a_rounded_25_game_title_b"
                                    android:ellipsize="marquee"
                                    android:paddingHorizontal="@dimen/idp_10"
                                    android:singleLine="true"
                                    app:mvAnimDuration="2000"
                                    app:mvDirection="right_to_left"
                                    app:mvInterval="5000"
                                    app:mvSingleLine="true"
                                    app:mvTextSize="@dimen/isp_13" />

                            </LinearLayout>

                            <com.zhpan.bannerview.BannerViewPager
                                android:id="@+id/banner_view"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/idp_180"
                                android:layout_marginTop="@dimen/idp_10"
                                app:bvp_indicator_visibility="visible"
                                app:bvp_round_corner="@dimen/idp_20" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="@dimen/idp_10">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/card_top"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/idp_70"
                                    android:onClick="@{()->click.img1()}"
                                    android:background="@drawable/mod_fragmen_main_bg_1"
                                    android:paddingHorizontal="@dimen/idp_20"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <ImageView
                                        android:layout_width="@dimen/idp_80"
                                        android:layout_height="@dimen/idp_80"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/mod_fragmen_main_bg_img_1"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="热门游戏估值"
                                        android:textColor="#FFFFFF"
                                        android:textSize="@dimen/isp_20"
                                        android:textStyle="bold"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/card_bottom_left"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/idp_110"
                                    android:layout_marginTop="@dimen/idp_10"
                                    android:layout_marginEnd="@dimen/idp_5"
                                    android:background="@drawable/mod_fragmen_main_bg_2"
                                    app:layout_constraintEnd_toStartOf="@+id/card_bottom_right"
                                    app:layout_constraintHorizontal_weight="1"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/card_top">

                                    <ImageView
                                        android:id="@+id/img_pink"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingEnd="@dimen/idp_30"
                                        android:onClick="@{()->click.img2()}"
                                        android:src="@drawable/mod_fragmen_main_bg_img_2"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="@dimen/idp_13"
                                        android:layout_marginBottom="@dimen/idp_40"
                                        android:gravity="end"
                                        android:lineSpacingExtra="@dimen/idp_3"
                                        android:text="游戏账号\n估值工具"
                                        android:textColor="#FFFFFF"
                                        android:textSize="@dimen/isp_16"
                                        android:textStyle="bold"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/card_bottom_right"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/idp_110"
                                    android:layout_marginStart="@dimen/idp_5"
                                    android:layout_marginTop="@dimen/idp_10"
                                    android:onClick="@{()->click.img3()}"
                                    android:background="@drawable/mod_fragmen_main_bg_3"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintHorizontal_weight="1"
                                    app:layout_constraintStart_toEndOf="@id/card_bottom_left"
                                    app:layout_constraintTop_toBottomOf="@id/card_top">

                                    <ImageView
                                        android:id="@+id/img_purple"
                                        android:layout_width="@dimen/idp_80"
                                        android:layout_height="wrap_content"
                                        android:src="@drawable/mod_fragmen_main_bg_img_3"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/idp_15"
                                        android:text="角色名生成器"
                                        android:textColor="#FFFFFF"
                                        android:textSize="@dimen/isp_16"
                                        android:textStyle="bold"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>


                            <TextView
                                android:id="@+id/titleText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/idp_10"
                                android:layout_marginTop="@dimen/idp_20"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:maxLines="1"
                                android:onClick="@{()->click.test()}"
                                android:text="热门估算播报"
                                android:textColor="@color/text_default_color"
                                android:textSize="@dimen/isp_18"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/text_ranking" />


                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/idp_10"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/saishiText"
                                tools:itemCount="10"
                                tools:listitem="@layout/mod_item_game_gusuan" />


                            <TextView
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/idp_10"
                                android:layout_marginTop="@dimen/idp_20"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:maxLines="1"
                                android:onClick="@{()->click.test()}"
                                android:text="热游速递"
                                android:textColor="@color/text_default_color"
                                android:textSize="@dimen/isp_18"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/text_ranking" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:visibility="gone"
                                android:id="@+id/recyclerView2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/idp_10"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/saishiText"
                                tools:itemCount="10"
                                tools:listitem="@layout/mod_item_game_event" />


                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <com.box.other.scwang.smart.refresh.footer.ClassicsFooter
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.box.other.scwang.smartrefresh.layout.SmartRefreshLayout>

        </com.box.common.ui.layout.StatusLayout>
    </LinearLayout>
</layout>