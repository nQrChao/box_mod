<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.box.mod.ui.activity.ModActivityMeSetting.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.activity.ModActivityMeSetting.ProxyClick" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F9F9F9">

        <com.box.other.hjq.titlebar.TitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/idp_40"
            android:background="@color/transparent"
            android:gravity="center"
            app:leftTitleColor="@color/black90"
            app:leftTitleSize="@dimen/isp_17"
            app:leftTitleStyle="bold"
            app:lineVisible="false"
            app:title="编辑资料"
            app:titleColor="@color/black90"
            app:titleSize="@dimen/isp_16"
            app:titleStyle="bold" />

        <com.box.other.scwang.smartrefresh.layout.SmartRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/titleBar"
            app:srlEnableFooterTranslationContent="true"
            app:srlEnableHeaderTranslationContent="true"
            app:srlEnableLoadMore="false"
            app:srlEnableOverScrollBounce="true"
            app:srlEnableOverScrollDrag="true"
            app:srlEnablePureScrollMode="true"
            app:srlReboundDuration="700">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/titleBar"
                android:layout_marginBottom="@dimen/idp_70">

                <LinearLayout
                    android:id="@+id/rootView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/idp_10"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_10"
                        android:text="修改头像"
                        android:textColor="@color/text_default_color"
                        android:textSize="@dimen/isp_15"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_15"
                        android:background="@drawable/a_rounded_15"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/idp_15"
                        android:paddingVertical="@dimen/idp_10"
                        android:weightSum="10">

                        <ImageView
                            android:id="@+id/user_icon"
                            android:layout_width="@dimen/idp_80"
                            android:layout_height="@dimen/idp_80"
                            android:layout_centerInParent="true"
                            android:layout_marginVertical="@dimen/idp_15"
                            android:onClick="@{()-> click.userIcon()}"
                            android:src="@drawable/mod_user_icon1"
                            app:borderColor="@{@color/mod_user_icon_color}"
                            app:borderWidth="@{3f}"
                            app:loadCircleWithBorderUri="@{vm.picUserIconUri}" />

                        <ImageView
                            android:layout_width="@dimen/idp_30"
                            android:layout_height="@dimen/idp_30"
                            android:layout_below="@id/user_icon"
                            android:layout_alignEnd="@id/user_icon"
                            android:layout_marginTop="-45dp"
                            android:onClick="@{()-> click.userIcon()}"
                            android:layout_marginEnd="-10dp"
                            android:background="@drawable/bg_blue_circle"
                            android:paddingHorizontal="@dimen/idp_3"
                            android:paddingVertical="@dimen/idp_3"
                            android:src="@android:drawable/ic_menu_camera" />


                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_15"
                        android:text="基本信息"
                        android:textColor="@color/text_default_color"
                        android:textSize="@dimen/isp_15"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_15"
                        android:background="@drawable/a_rounded_15"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/idp_15"
                        android:paddingVertical="@dimen/idp_10"
                        android:weightSum="10">

                        <com.box.common.ui.layout.SettingBar
                            android:id="@+id/user_account_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/idp_5"
                            android:background="@drawable/transparent_selector"
                            android:onClick="@{()-> click.userName()}"
                            app:bar_leftText="用户昵称"
                            app:bar_leftTextStyle="bold"
                            app:bar_lineVisible="false"
                            app:bar_rightDrawable="@drawable/mod_right_return"
                            app:bar_rightDrawableSize="@dimen/idp_20" />

                        <com.box.common.ui.layout.SettingBar
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/idp_10"
                            android:layout_marginBottom="@dimen/idp_5"
                            android:background="@drawable/transparent_selector"
                            android:onClick="@{()-> click.userPwd()}"
                            app:bar_leftText="修改密码"
                            app:bar_leftTextStyle="bold"
                            app:bar_lineVisible="false"
                            app:bar_rightDrawable="@drawable/mod_right_return"
                            app:bar_rightDrawableSize="@dimen/idp_20" />


                    </LinearLayout>


                </LinearLayout>

            </androidx.core.widget.NestedScrollView>
        </com.box.other.scwang.smartrefresh.layout.SmartRefreshLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/idp_20"
            android:paddingVertical="@dimen/idp_15">

            <Button
                android:id="@+id/btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/idp_45"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/idp_10"
                android:background="@drawable/mod_btn_confirm_selector"
                android:text="保存"
                android:textColor="@color/white"
                android:textSize="@dimen/mod_button_text_size"
                android:textStyle="bold"
                app:onSingleClick="@{() -> click.confirm()}"
                app:singleClickDelay="@{1000L}"
                tools:text="保存" />
        </LinearLayout>

    </RelativeLayout>
</layout>