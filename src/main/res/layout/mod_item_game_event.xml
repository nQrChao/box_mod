<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="modData"
            type="com.box.common.data.model.ModDataBean" />

    </data>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/idp_180"
        android:background="@color/white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/pic1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:cornerRadius="@{20f}"
            app:imageUrl="@{modData.image}"
            tools:src="@drawable/mod_test_pic2" />

        <ImageView
            android:id="@+id/bg_black_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_black_trans_bottom" />

        <ImageView
            android:id="@+id/button"
            android:layout_width="@dimen/idp_35"
            android:layout_height="@dimen/idp_35"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="@dimen/idp_10"
            android:layout_marginBottom="@dimen/idp_25"
            android:gravity="end"
            android:src="@{modData.isShouCang ? @drawable/mod_ic_fire1 : @drawable/mod_ic_fire0}"
            tools:src="@drawable/mod_ic_fire1" />

        <RelativeLayout
            android:layout_marginBottom="@dimen/idp_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/idp_10"
            android:weightSum="10">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/idp_45"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="2"
                android:text="@{modData.title}"
                android:textColor="@color/white"
                android:textSize="@dimen/isp_13"
                tools:text="《英雄联盟》2025总决赛总决赛总决赛总决赛总决赛总决赛总决赛总决赛总决赛总决赛！" />

            <TextView
                android:layout_below="@id/title"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/idp_2"
                app:setFormattedTimestamp="@{modData.createTime}"
                android:textColor="#989898"
                android:textSize="@dimen/isp_12"
                tools:text="2025-11-9 12:19:24" />

        </RelativeLayout>

    </FrameLayout>

</layout>