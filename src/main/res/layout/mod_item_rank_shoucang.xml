<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="modData"
            type="com.box.common.data.model.ModDataBean" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/a_rounded_10"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/idp_10"
        android:paddingVertical="@dimen/idp_10">


        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/idp_45"
            android:layout_height="@dimen/idp_45"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/idp_15"
            app:loadRound11Image="@{modData.url}"
            tools:src="@mipmap/mod_icon" />

        <LinearLayout
            android:id="@+id/nameLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/idp_20"
            android:layout_toEndOf="@id/icon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{modData.name}"
                android:textColor="@color/text_default_color"
                android:textSize="@dimen/isp_15"
                android:textStyle="bold"
                tools:text="剑侠情缘" />

            <TextView
                android:id="@+id/des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/idp_2"
                android:gravity="center"
                android:text="@{modData.tag}"
                android:textColor="@color/text_hit_color"
                android:textSize="@dimen/isp_13"
                tools:text="现代战略  |  合并" />

        </LinearLayout>

        <ImageView
            android:id="@+id/shoucang"
            android:layout_width="@dimen/idp_22"
            android:layout_height="@dimen/idp_22"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/idp_15"
            android:src="@{modData.isShouCang ? @drawable/mod_ic_shoucang1 : @drawable/mod_ic_shoucang0}"
            tools:src="@drawable/mod_ic_shoucang1" />


    </RelativeLayout>

</layout>