<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="modData"
            type="com.box.common.data.model.ModDataBean" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/idp_90"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view_root"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/idp_10"
            android:layout_marginBottom="@dimen/idp_4"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/idp_10"
            app:cardElevation="@dimen/idp_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/textRootView"
                android:layout_width="@dimen/idp_80"
                android:layout_height="wrap_content"
                android:background="@drawable/gujia_item_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/idp_10"
                android:paddingTop="@dimen/idp_50"
                android:paddingBottom="@dimen/idp_10">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/idp_5"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{modData.name}"
                    android:textColor="#253E75"
                    android:textSize="@dimen/isp_14"
                    android:textStyle="bold"
                    tools:text="王者荣耀" />

                <Button
                    android:visibility="gone"
                    android:id="@+id/commit"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/idp_26"
                    android:layout_marginTop="@dimen/idp_10"
                    android:layout_marginBottom="@dimen/idp_3"
                    android:background="@drawable/gujia_item_btn_bg"
                    android:text="我要估值"
                    android:textColor="@color/white"
                    android:textSize="@dimen/isp_12"
                    android:textStyle="bold" />


            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/idp_58"
            android:layout_height="@dimen/idp_58"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/idp_3"
            android:elevation="@dimen/idp_4"
            app:cornerRadius="@{10f}"
            app:imageUrl="@{modData.url}"
            app:hideOnNullOrError="@{false}"
            app:layout_constraintEnd_toEndOf="@id/card_view_root"
            app:layout_constraintStart_toStartOf="@id/card_view_root"
            tools:src="@drawable/mod_icon" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>