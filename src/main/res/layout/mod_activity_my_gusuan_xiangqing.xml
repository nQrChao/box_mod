<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="vm"
            type="com.box.mod.ui.activity.ModActivityGuSuanXiangqing.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.activity.ModActivityGuSuanXiangqing.ProxyClick" />
    </data>

    <RelativeLayout
        android:background="#F9F9F9"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/idp_15"
                android:paddingVertical="@dimen/idp_5">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/a_rounded_15"
                    android:paddingHorizontal="@dimen/idp_10"
                    android:paddingVertical="@dimen/idp_15">

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="@dimen/idp_58"
                        android:layout_height="@dimen/idp_58"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/idp_3"
                        android:elevation="@dimen/idp_4"
                        app:cornerRadius="@{10f}"
                        app:hideOnNullOrError="@{false}"
                        app:imageUrl="@{vm.modData.gameIcon}"
                        app:layout_constraintEnd_toEndOf="@id/textRootView"
                        app:layout_constraintStart_toStartOf="@id/textRootView"
                        tools:src="@drawable/mod_icon" />

                    <LinearLayout
                        android:layout_marginEnd="@dimen/idp_110"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/idp_10"
                        android:layout_toEndOf="@id/icon"
                        android:layout_toLeftOf="@id/priceLayout"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/idp_5"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{vm.modData.gameName}"
                            android:textColor="@color/text_default_color"
                            android:textSize="@dimen/isp_14"
                            android:textStyle="bold"
                            tools:text="王者荣耀王王者荣耀王王者荣耀王" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/idp_5"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="卡牌 动漫"
                            android:textColor="#8A8A8A"
                            android:textSize="@dimen/isp_13"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/priceLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_val_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="@dimen/idp_4"
                            android:background="@drawable/a_rounded_5_gray"
                            android:paddingHorizontal="@dimen/idp_8"
                            android:paddingVertical="@dimen/idp_2"
                            android:text="估值"
                            android:textColor="#999999"
                            android:textSize="@dimen/isp_12" />

                        <TextView
                            android:id="@+id/tv_money"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="@{`¥ ` + vm.modData.money}"
                            android:textColor="#FF5722"
                            android:textSize="@dimen/isp_18"
                            android:textStyle="bold"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_game_name"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="￥8888" />
                    </LinearLayout>


                </RelativeLayout>

                <com.box.common.ui.view.DrawableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_15"
                    android:drawablePadding="@dimen/idp_5"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="基本信息"
                    android:textSize="@dimen/isp_16"
                    android:textStyle="bold"
                    app:drawableHeight="@dimen/idp_18"
                    app:drawableWidth="@dimen/idp_7" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_10"
                    android:background="@drawable/a_rounded_15"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/idp_15"
                    android:paddingVertical="@dimen/idp_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_3"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="估算时间："
                            android:textColor="#8A8A8A"
                            android:textSize="@dimen/isp_13"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_3"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="2025-11-11 22:22:22"
                            android:textColor="#101010"
                            android:textSize="@dimen/isp_13" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_5"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_3"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="小号　　："
                            android:textColor="#8A8A8A"
                            android:textSize="@dimen/isp_13"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_3"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="这是小号名称"
                            android:textColor="#101010"
                            android:textSize="@dimen/isp_13" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_5"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_3"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="区服　　："
                            android:textColor="#8A8A8A"
                            android:textSize="@dimen/isp_13"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_3"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="这是区服信息"
                            android:textColor="#101010"
                            android:textSize="@dimen/isp_13" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_5"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_3"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="备注　　："
                            android:textColor="#8A8A8A"
                            android:textSize="@dimen/isp_13"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/idp_3"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="这是备注内容"
                            android:textColor="#101010"
                            android:textSize="@dimen/isp_13" />

                    </LinearLayout>


                </LinearLayout>

                <com.box.common.ui.view.DrawableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_15"
                    android:drawablePadding="@dimen/idp_5"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="账号截图"
                    android:textSize="@dimen/isp_16"
                    android:textStyle="bold"
                    app:drawableHeight="@dimen/idp_18"
                    app:drawableWidth="@dimen/idp_7" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/idp_10"
                    android:background="@drawable/a_rounded_15"
                    android:paddingHorizontal="@dimen/idp_10"
                    android:paddingVertical="@dimen/idp_20"
                    tools:itemCount="1"
                    tools:listitem="@layout/mod_item_custom_form_xiangqing_pic" />

                <com.box.common.ui.view.DrawableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_20"
                    android:drawableStart="@drawable/gujia_xiangqing_ic_jinggao"
                    android:drawablePadding="@dimen/idp_5"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="温馨提示"
                    android:textColor="#F2510C"
                    android:textSize="@dimen/isp_13"
                    android:textStyle="bold"
                    app:drawableHeight="@dimen/idp_20"
                    app:drawableWidth="@dimen/idp_20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/idp_5"
                    android:ellipsize="end"
                    android:text="        账号价格为基于账号内等级、道具、稀有物品等现有信息的估算值，实际价值可能受游戏官方规则调整、市场供需波动、账号绑定状态等因素影响，最终价格以游戏内核实结果或双方协商为准。"
                    android:textColor="@color/text_default_color"
                    android:textSize="@dimen/isp_13"
                    tools:text="        账号价格为基于账号内等级、道具、稀有物品等现有信息的估算值，实际价值可能受游戏官方规则调整、市场供需波动、账号绑定状态等因素影响，最终价格以游戏内核实结果或双方协商为准。" />

                <com.box.common.ui.view.DrawableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_20"
                    android:drawablePadding="@dimen/idp_5"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="其他热门游戏账号估值"
                    android:textSize="@dimen/isp_16"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableHeight="@dimen/idp_18"
                    app:drawableWidth="@dimen/idp_7" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_10"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:itemCount="1"
                    tools:listitem="@layout/mod_item_gujia_game_re" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


    </RelativeLayout>
</layout>