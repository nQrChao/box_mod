<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.box.mod.ui.fragment.ModFragmentWode.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.fragment.ModFragmentWode.ProxyClick" />
    </data>

    <LinearLayout
        android:id="@+id/rootView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mod_home_bg_color"
        android:orientation="vertical">

        <com.box.other.hjq.titlebar.TitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/idp_40"
            android:background="@color/white"
            android:gravity="center"
            app:leftIcon="@null"
            app:lineVisible="true"
            app:rightIcon="@null"
            app:rightIconGravity="start"
            app:rightIconHeight="@dimen/idp_20"
            app:rightIconWidth="@dimen/idp_20"
            app:rightTitleColor="#6493FA"
            app:rightTitleSize="@dimen/isp_14"
            app:rightTitleStyle="bold"
            app:titleColor="@color/black90"
            app:titleSize="@dimen/isp_16"
            app:titleStyle="bold" />

    </LinearLayout>
</layout>