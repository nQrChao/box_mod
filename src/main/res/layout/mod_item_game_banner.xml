<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="modData"
            type="com.box.common.data.model.ModDataBean" />

    </data>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/pic1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:cornerRadius="@{20f}"
            app:imageUrl="@{modData.gameAccountIcon}"
            tools:src="@drawable/mod_test_pic2" />

        <ImageView
            android:id="@+id/bg_black_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_black_trans_bottom" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/idp_60"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_20_radius"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/idp_20"
            android:paddingVertical="@dimen/idp_8"
            android:weightSum="10">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/game_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/idp_10"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:text="@{modData.gameName}"
                    android:textColor="@color/white"
                    android:textSize="@dimen/isp_15"
                    tools:text="《英雄联盟》" />

                <TextView
                    android:id="@+id/game_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_2"
                    android:layout_marginEnd="@dimen/idp_10"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{modData.characteristic}"
                    android:textColor="@color/white"
                    android:textSize="@dimen/isp_12"
                    tools:text="《王者荣耀》23区，黄金段位" />

            </LinearLayout>

            <TextView
                android:id="@+id/game_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@{`¥ ` + modData.money}"
                android:textColor="#FF5722"
                android:textSize="@dimen/isp_20"
                android:textStyle="bold"
                tools:text="¥ 88888" />

            <TextView
                android:id="@+id/tv_val_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/idp_8"
                android:layout_toLeftOf="@id/game_money"
                android:background="@drawable/bg_button_20_radius"
                android:paddingHorizontal="@dimen/idp_10"
                android:paddingVertical="@dimen/idp_3"
                android:text="估值"
                android:textColor="@color/white"
                android:textSize="@dimen/isp_12" />


        </RelativeLayout>

    </FrameLayout>

</layout>