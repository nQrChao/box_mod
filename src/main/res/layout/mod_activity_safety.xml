<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.box.mod.ui.activity.ModActivitySettingSafety.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.activity.ModActivitySettingSafety.ProxyClick" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/anchor_sell_faq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/idp_10"
            android:background="@drawable/a_rounded_10"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/idp_10"
            android:paddingVertical="@dimen/idp_15">

            <com.box.common.ui.layout.SettingBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/idp_10"
                android:background="@drawable/transparent_selector"
                android:onClick="@{()-> click.yonghuxieyi()}"
                app:bar_leftText="用户协议"
                app:bar_leftTextStyle="bold"
                app:bar_rightDrawable="@drawable/mod_right_return"
                app:bar_rightDrawableSize="@dimen/idp_20"
                app:bar_rightTextColor="@color/text_hit_color"
                app:bar_rightTextSize="@dimen/isp_13" />

            <com.box.common.ui.layout.SettingBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/idp_10"
                android:background="@drawable/transparent_selector"
                android:onClick="@{()-> click.yinsixieyi()}"
                app:bar_leftText="隐私政策"
                app:bar_leftTextStyle="bold"
                app:bar_rightDrawable="@drawable/mod_right_return"
                app:bar_rightDrawableSize="@dimen/idp_20"
                app:bar_rightTextColor="@color/text_hit_color"
                app:bar_rightTextSize="@dimen/isp_13" />

            <com.box.common.ui.layout.SettingBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/idp_10"
                android:background="@drawable/transparent_selector"
                android:onClick="@{()-> click.zhuxiao()}"
                android:visibility="@{vm.isLogin?View.VISIBLE:View.GONE}"
                app:bar_leftText="账号注销"
                app:bar_leftTextStyle="bold"
                app:bar_rightDrawable="@drawable/mod_right_return"
                app:bar_rightDrawableSize="@dimen/idp_20"
                app:bar_rightTextColor="@color/text_hit_color"
                app:bar_rightTextSize="@dimen/isp_13" />


        </LinearLayout>
    </RelativeLayout>
</layout>