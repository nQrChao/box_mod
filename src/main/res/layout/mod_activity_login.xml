<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="vm"
            type="com.box.mod.ui.activity.ModActivityLogin.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.activity.ModActivityLogin.ProxyClick" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titlePicLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/titlePic"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:src="@drawable/bg_login_title"
                app:layout_constraintDimensionRatio="590:498"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/ic_return"
            android:layout_width="@dimen/idp_1"
            android:layout_height="@dimen/idp_50"
            android:layout_marginTop="@dimen/idp_25" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="true">

            <LinearLayout
                android:layout_marginTop="@dimen/idp_50"
                android:paddingHorizontal="@dimen/idp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/login_title_text1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_20"
                    android:text="你好，"
                    android:textColor="@color/text_default_color"
                    android:textSize="@dimen/isp_20"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/login_title_text2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_5"
                    android:onClick="@{()-> click.testClick()}"
                    android:text="@{StringUtils.format(&quot;欢迎使用%s&quot;, vm.pName)}"
                    android:textColor="@color/text_default_color"
                    android:textSize="@dimen/isp_20"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/login_title_text1"
                    tools:text="欢迎使用" />

                <LinearLayout
                    android:id="@+id/mobile_ll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/idp_60"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/idp_30"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/login_title_text2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_10"
                        android:text="用户名"
                        android:textColor="@color/text_default_color"
                        android:textColorHint="@color/text_default_color"
                        android:textSize="@dimen/isp_12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.box.common.ui.view.ClearEditText
                            android:id="@+id/login_mobile"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="请输入用户名"
                            android:inputType="number"
                            android:lines="1"
                            android:maxLength="11"
                            android:paddingHorizontal="@dimen/idp_10"
                            android:singleLine="true"
                            android:text="@={vm.uName}"
                            android:textColor="@color/black"
                            android:textColorHint="@color/text_hit_color"
                            android:textSize="@dimen/isp_14"
                            app:regexType="mobile" />

                    </LinearLayout>

                    <View style="@style/HorizontalLineStyle" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/password_ll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/idp_60"
                    android:layout_marginTop="@dimen/idp_10"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mobile_ll">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="密码"
                        android:textColor="@color/text_default_color"
                        android:textColorHint="@color/text_default_color"
                        android:textSize="@dimen/isp_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/text2" />

                    <com.box.common.ui.view.PasswordEditText
                        android:id="@+id/login_password"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="请输入密码"
                        android:inputType="text"
                        android:lines="1"
                        android:paddingHorizontal="@dimen/idp_10"
                        android:text="@={vm.password}"
                        android:textColor="@color/black"
                        android:textColorHint="@color/text_hit_color"
                        android:textSize="@dimen/isp_14" />

                    <View style="@style/HorizontalLineStyle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/loginForget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:onClick="@{()-> click.forgetPwd()}"
                    android:paddingTop="@dimen/idp_5"
                    android:text="忘记密码"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/isp_13"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/password_ll" />

                <Button
                    android:id="@+id/loginSub"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/idp_40"
                    android:layout_marginTop="@dimen/idp_30"
                    android:layout_marginBottom="@dimen/idp_10"
                    android:background="@drawable/button_submit_selector"
                    android:gravity="center"
                    android:text="登录"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="@dimen/isp_15"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/loginForget"
                    app:noRepeatClick="@{click::login}" />


                <LinearLayout
                    android:id="@+id/reg_text_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/idp_10"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/loginSub">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="没有账号？"
                        android:textColor="@color/text_hit_color"
                        android:textSize="@dimen/isp_14" />

                    <TextView
                        android:id="@+id/loginGoregister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="立即注册"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/isp_14"
                        bind:noRepeatClick="@{()-> click.goRegister()}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/reg_text_ll">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/idp_30"
                        android:text="其他登录方式"
                        android:textColor="@color/text_hit_color"
                        android:textSize="@dimen/isp_14"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/login_other_ll" />


                </LinearLayout>


            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/ll_agree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/idp_10"
            android:paddingVertical="@dimen/idp_20">

            <CheckBox
                android:id="@+id/agreementButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@null"
                android:button="@drawable/radiobutton_selector"
                android:checked="false"
                app:checkChange="@{click.agreementButtonChangeListener}" />

            <TextView
                android:id="@+id/tv_agree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/idp_10"
                android:text="我已阅读并同意《隐私协议》、《用户协议》"
                android:textColor="@color/text_default_color"
                android:textSize="@dimen/isp_13" />

        </LinearLayout>
    </RelativeLayout>
</layout>