<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="vm"
            type="com.box.mod.ui.fragment.ModFragmentShengChengQi.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.fragment.ModFragmentShengChengQi.ProxyClick" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <com.box.other.hjq.titlebar.TitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/idp_40"
            android:background="@color/white"
            android:gravity="center"
            app:leftIcon="@null"
            app:lineVisible="true"
            app:rightIcon="@drawable/mod_1_ic_shoucang"
            app:rightIconGravity="start"
            app:rightIconHeight="@dimen/idp_20"
            app:rightIconWidth="@dimen/idp_20"
            app:rightTitleColor="#6493FA"
            app:rightTitleSize="@dimen/isp_14"
            app:rightTitleStyle="bold"
            app:titleColor="@color/black90"
            app:titleSize="@dimen/isp_16"
            app:titleStyle="bold" />

        <com.box.other.scwang.smartrefresh.layout.SmartRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/titleBar"
            app:srlEnableFooterTranslationContent="true"
            app:srlEnableHeaderTranslationContent="true"
            app:srlEnableLoadMore="false"
            app:srlEnableOverScrollBounce="true"
            app:srlEnableOverScrollDrag="true"
            app:srlEnablePureScrollMode="true"
            app:srlReboundDuration="700">

            <com.box.common.ui.layout.StatusLayout
                android:id="@+id/status_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/titleBar"
                    android:layout_marginBottom="@dimen/idp_70">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/idp_10"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/idp_10">

                        <TextView
                            android:id="@+id/gamePicTitle"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5"
                            android:gravity="start"
                            android:text="@{StringUtils.format(&quot;选择类型：%s&quot;, vm.typeName)}"
                            android:textColor="@color/text_default_color"
                            android:textSize="@dimen/mod_edit_title_text_size"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/idp_10"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            tools:itemCount="3"
                            tools:listitem="@layout/mod_item_role_type" />


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/idp_10"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/label1"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/idp_60"
                                android:layout_weight="3"
                                android:background="@drawable/bg_item_create_text_2"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="三字"
                                android:textColor="@color/text_default_color"
                                android:textSize="@dimen/isp_16"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/label2"
                                app:layout_constraintHorizontal_weight="1"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:background="@drawable/bg_item_create_text_2"
                                tools:text="三字" />

                            <TextView
                                android:id="@+id/label2"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/idp_60"
                                android:layout_weight="3"
                                android:background="@drawable/bg_item_create_text_2"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:paddingHorizontal="@dimen/idp_10"
                                android:text="四字"
                                android:textColor="@color/text_default_color"
                                android:textSize="@dimen/isp_16"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toStartOf="@+id/label3"
                                app:layout_constraintHorizontal_weight="1"
                                app:layout_constraintStart_toEndOf="@+id/label1"
                                app:layout_constraintTop_toTopOf="@+id/label1"
                                tools:background="@drawable/bg_item_create_text_2"
                                tools:text="四字" />

                            <TextView
                                android:id="@+id/label3"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/idp_60"
                                android:layout_weight="3"
                                android:background="@drawable/bg_item_create_text_2"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="五字以上"
                                android:textColor="@color/text_default_color"
                                android:textSize="@dimen/isp_16"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_weight="1"
                                app:layout_constraintStart_toEndOf="@+id/label2"
                                app:layout_constraintTop_toTopOf="@+id/label1"
                                tools:background="@drawable/bg_item_create_text_2"
                                tools:text="五字以上" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/idp_20"
                            android:layout_weight="5"
                            android:gravity="start"
                            android:text="@{StringUtils.format(&quot;选择长度：%s&quot;, vm.lengthName)}"
                            android:textColor="@color/text_default_color"
                            android:textSize="@dimen/mod_edit_title_text_size"
                            android:textStyle="bold" />


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/lengthLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/idp_10">

                            <TextView
                                android:id="@+id/textView1"
                                android:layout_width="@dimen/idp_110"
                                android:layout_height="@dimen/idp_60"
                                android:background="@{vm.isSelect() == 3 ? @drawable/bg_item_create_text_000000 : @drawable/bg_item_create_text_dddddd}"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:onClick="@{()->click.text3()}"
                                android:text="三字"
                                android:textColor="@{vm.isSelect() == 3?@color/text_select_color:@color/common_text_color_sec_gray}"
                                android:textSize="@dimen/isp_16"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/textView2"
                                app:layout_constraintHorizontal_chainStyle="spread_inside"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:background="@drawable/bg_item_create_text_000000"
                                tools:textColor="@color/text_select_color" />

                            <TextView
                                android:id="@+id/textView2"
                                android:layout_width="@dimen/idp_110"
                                android:layout_height="@dimen/idp_60"
                                android:background="@{vm.isSelect() == 4 ? @drawable/bg_item_create_text_000000 : @drawable/bg_item_create_text_dddddd}"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:onClick="@{()->click.text4()}"
                                android:text="四字"
                                android:textColor="@{vm.isSelect() == 4?@color/text_select_color:@color/common_text_color_sec_gray}"
                                android:textSize="@dimen/isp_16"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toStartOf="@+id/textView3"
                                app:layout_constraintStart_toEndOf="@+id/textView1"
                                app:layout_constraintTop_toTopOf="@+id/textView1"
                                tools:background="@drawable/bg_item_create_text_dddddd" />

                            <TextView
                                android:id="@+id/textView3"
                                android:layout_width="@dimen/idp_110"
                                android:layout_height="@dimen/idp_60"
                                android:background="@{vm.isSelect() == 5 ? @drawable/bg_item_create_text_000000 : @drawable/bg_item_create_text_dddddd}"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:onClick="@{()->click.text5()}"
                                android:text="五字以上"
                                android:textColor="@{vm.isSelect() == 5?@color/text_select_color:@color/common_text_color_sec_gray}"
                                android:textSize="@dimen/isp_16"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/textView2"
                                app:layout_constraintTop_toTopOf="@+id/textView1"
                                tools:background="@drawable/bg_item_create_text_dddddd" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <LinearLayout
                            android:id="@+id/randomNameLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/idp_15"
                            android:background="@drawable/bg_mod_gujia_window"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/idp_5"
                            android:paddingVertical="@dimen/idp_15"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/gameInfoLayout">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginHorizontal="@dimen/idp_11"
                                android:layout_marginTop="@dimen/idp_10"
                                android:layout_weight="5"
                                android:gravity="center"
                                android:text="角色名生成结果"
                                android:textColor="@color/text_default_color"
                                android:textSize="@dimen/mod_edit_title_text_size"
                                android:textStyle="bold" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerView2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/idp_15"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                tools:itemCount="2"
                                tools:listitem="@layout/mod_item_juese_list" />


                        </LinearLayout>


                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>

            </com.box.common.ui.layout.StatusLayout>
        </com.box.other.scwang.smartrefresh.layout.SmartRefreshLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/idp_20"
            android:paddingVertical="@dimen/idp_15">

            <Button
                android:id="@+id/btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/idp_45"
                android:layout_marginBottom="@dimen/idp_10"
                android:layout_gravity="center"
                android:background="@drawable/mod_btn_confirm_selector"
                android:text="一键生成"
                android:textColor="@color/white"
                android:textSize="@dimen/mod_button_text_size"
                android:textStyle="bold"
                app:onSingleClick="@{() -> click.confirm()}"
                app:singleClickDelay="@{1000L}"
                tools:text="一键生成" />
        </LinearLayout>
    </RelativeLayout>
</layout>