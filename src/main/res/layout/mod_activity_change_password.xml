<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.box.other.blankj.utilcode.util.StringUtils" />

        <variable
            name="vm"
            type="com.box.mod.ui.activity.ModActivityChangePassword.Model" />

        <variable
            name="click"
            type="com.box.mod.ui.activity.ModActivityChangePassword.ProxyClick" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <com.box.other.hjq.titlebar.TitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/idp_40"
            android:background="@color/transparent"
            android:gravity="center"
            app:leftTitleColor="@color/black90"
            app:leftTitleSize="@dimen/isp_17"
            app:leftTitleStyle="bold"
            app:lineVisible="false"
            app:title="修改密码"
            app:titleColor="@color/black90"
            app:titleSize="@dimen/isp_16"
            app:titleStyle="bold" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/titleBar"
            android:fadeScrollbars="true">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/idp_20">

                <TextView
                    android:id="@+id/login_title_text1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/idp_30"
                    android:text="@{StringUtils.format(&quot;用户: %s&quot;, vm.modUserInfo.nickName)}"
                    android:textColor="@color/text_default_color"
                    android:textSize="@dimen/isp_20"
                    android:textStyle="bold"
                    tools:text="用户：小小的小鸟"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/idp_70"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/idp_25"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/idp_10"
                        android:text="旧密码"
                        android:textColor="@color/text_default_color"
                        android:textColorHint="@color/text_default_color"
                        android:textSize="@dimen/isp_14" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.box.common.ui.view.PasswordEditText
                            android:id="@+id/oldPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="请输入旧密码"
                            android:inputType="text"
                            android:maxLength="16"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/idp_10"
                            android:singleLine="true"
                            android:text="@={vm.oldPassword}"
                            android:textColor="@color/black"
                            android:textColorHint="@color/text_hit_color"
                            android:textSize="@dimen/isp_15" />

                    </LinearLayout>

                    <View style="@style/HorizontalLineStyle" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/password_ll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/idp_60"
                    android:layout_marginTop="@dimen/idp_10"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="新密码"
                        android:textColor="@color/text_default_color"
                        android:textColorHint="@color/text_default_color"
                        android:textSize="@dimen/isp_14" />

                    <com.box.common.ui.view.PasswordEditText
                        android:id="@+id/newPassword"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="请输入新密码"
                        android:inputType="text"
                        android:maxLength="16"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/idp_10"
                        android:text="@={vm.newPassword}"
                        android:textColor="@color/black"
                        android:textColorHint="@color/text_hit_color"
                        android:textSize="@dimen/isp_15" />

                    <View style="@style/HorizontalLineStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/password2_ll"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/idp_60"
                        android:layout_marginTop="@dimen/idp_10"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="确认密码"
                            android:textColor="@color/text_default_color"
                            android:textColorHint="@color/text_default_color"
                            android:textSize="@dimen/isp_14" />

                        <com.box.common.ui.view.PasswordEditText
                            android:id="@+id/newPassword2"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="请再次输入新密码"
                            android:inputType="text"
                            android:maxLength="16"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/idp_10"
                            android:text="@={vm.newPassword2}"
                            android:textColor="@color/black"
                            android:textColorHint="@color/text_hit_color"
                            android:textSize="@dimen/isp_15" />

                        <View style="@style/HorizontalLineStyle" />
                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/idp_20"
            android:paddingVertical="@dimen/idp_15">

            <Button
                android:id="@+id/btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/idp_45"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/idp_10"
                android:background="@drawable/mod_btn_confirm_selector"
                android:text="修改"
                android:textColor="@color/white"
                android:textSize="@dimen/mod_button_text_size"
                android:textStyle="bold"
                app:onSingleClick="@{() -> click.changePassword()}"
                app:singleClickDelay="@{1000L}"
                tools:text="修改" />
        </LinearLayout>


    </RelativeLayout>
</layout>